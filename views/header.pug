            .navItems
              li.nav__items.navItemsSmall
                a(href="/").nav__link Home
            .navItems
              li.nav__items.navItemsSmall  
                a(href="/").nav__link About Me
            .navItems
              li.nav__items.navItemsSmall  
                a(href="/").nav__link Articles 
            .navItems
              li.nav__items.navItemsSmall
                a(href="/").nav__link Interactive
            .prettyLine

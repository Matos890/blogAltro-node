header
  .headerWrapper
    .contentWrapperLogo
      a(href="/")
    .contentWrapperNav.flex
      .navWrapper
        nav.largeScreen
          ul.garamond.navToStylize
            .navItems
              li.nav__items 
                a(href="/").nav__link Home
            .navItems
              li.nav__items  
                a(href="/").nav__link About Me
            .navItems
               li

                a(href="/").logo-image
                  img(class='altroIcon' src="/img/AltroIconRed-02-01.png", alt="")
            .navItems
              li.nav__items  
                a(href="/").nav__link Articles 
            .navItems
              li.nav__items 
